const fmt  = (n) => n?.toLocaleString("pt-BR", { style:"currency", currency:"BRL" });
const fmtD = (s) => new Date(s).toLocaleDateString("pt-BR", { day:"2-digit", month:"2-digit", hour:"2-digit", minute:"2-digit" });

function Toast({ msg, onClose }) {
  useEffect(() => { const t = setTimeout(onClose, 3500); return () => clearTimeout(t); }, [onClose]);
  return <div className="toast">✅ {msg}</div>;
}

// ─── LOGIN ────────────────────────────────────────────────────────────────────
function LoginPage({ onLogin, goToStore }) {
  const [u, setU] = useState(""); const [p, setP] = useState(""); const [err, setErr] = useState("");
  const handle = () => {
    const usr = USERS[u.toLowerCase()];
    if (usr && usr.password === p) { onLogin({ username: u, ...usr }); }
    else { setErr("Usuário ou senha inválidos."); }
  };
  return (
    <div className="login-page">
      <div className="login-box fade-up">
        <div style={{ textAlign:"center", marginBottom:32 }}>
          <div style={{ fontFamily:"var(--font-h)", fontSize:32, fontWeight:800 }}>
            IRECÊ<span style={{ color:"var(--accent)" }}>TECH</span>
          </div>
          <div style={{ fontSize:12, color:"var(--muted)", marginTop:4 }}>Smart Commerce — Painel de Gestão</div>
        </div>
        <div className="card">
          <h2>Entrar</h2>
          <p>Acesse com suas credenciais de funcionário</p>
          <div className="form-group">
            <label>USUÁRIO</label>
            <input className="input" placeholder="Ex: admin, logistica…" value={u} onChange={e=>setU(e.target.value)} onKeyDown={e=>e.key==="Enter"&&handle()} />
          </div>
          <div className="form-group">
            <label>SENHA</label>
            <input className="input" type="password" placeholder="••••••••" value={p} onChange={e=>setP(e.target.value)} onKeyDown={e=>e.key==="Enter"&&handle()} />
          </div>
          {err && <div style={{ color:"var(--danger)", fontSize:12, marginBottom:12 }}>{err}</div>}
          <button className="btn btn-primary" style={{ width:"100%", justifyContent:"center", marginBottom:12 }} onClick={handle}>Entrar no Painel</button>
          <button className="btn btn-ghost" style={{ width:"100%", justifyContent:"center" }} onClick={goToStore}>🛍️ Ver Loja (cliente)</button>
        </div>
        <div style={{ marginTop:16, padding:12, background:"rgba(0,212,255,.06)", borderRadius:10, fontSize:11, color:"var(--muted)", lineHeight:1.8 }}>
          <strong style={{ color:"var(--accent)" }}>Credenciais de demonstração:</strong><br/>
          admin / admin123 &nbsp;|&nbsp; logistica / log123<br/>
          comercial / com123 &nbsp;|&nbsp; financeiro / fin123
        </div>
      </div>
    </div>
  );
}

