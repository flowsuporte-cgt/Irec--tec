          <button className="btn btn-primary" style={{ width:"100%", justifyContent:"center" }} onClick={()=>{ setCupons(prev=>[...prev,{...form,id:Date.now(),active:true}]); setForm({code:"",discount:"",type:"%",expires:""}); showToast("Cupom criado!"); }}>Criar Cupom</button>
        </div>
        <div className="card" style={{ padding:0 }}>
          <table>
            <thead><tr><th>CÓDIGO</th><th>DESCONTO</th><th>VALIDADE</th><th>ATIVO</th></tr></thead>
            <tbody>
              {cupons.map(c=>(
                <tr key={c.id}>
                  <td><code style={{ color:"var(--accent2)", fontWeight:700 }}>{c.code}</code></td>
                  <td>{c.discount}{c.type}</td>
                  <td style={{ fontSize:12, color:"var(--muted)" }}>{c.expires||"Sem validade"}</td>
                  <td><StatusToggle active={c.active} onToggle={()=>{ setCupons(prev=>prev.map(x=>x.id===c.id?{...x,active:!x.active}:x)); }} /></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
}

