                <div style={{ fontSize:13, fontWeight:500 }}>{o.customer_name}</div>
                <div style={{ fontSize:11, color:"var(--muted)" }}>{o.product.split(" ").slice(0,3).join(" ")}</div>
              </div>
              <div style={{ textAlign:"right" }}>
                <div style={{ fontSize:13, fontWeight:600, color:"var(--accent)" }}>{fmt(o.total_amount)}</div>
                <StatusBadge s={o.status} />
              </div>
            </div>
          ))}
        </div>
        <div className="card">
          <div style={{ fontFamily:"var(--font-h)", fontWeight:700, marginBottom:16 }}>Estoque por Categoria</div>
          {["Smartphones","Cadeiras Gamer","Notebooks","Acessórios","Monitores"].map(cat=>{
            const prods = MOCK_PRODUCTS.filter(p=>p.category===cat);
            const total = prods.reduce((a,p)=>a+p.stock_qty,0);
            const pct = Math.min(100, (total/30)*100);
            return (
              <div key={cat} style={{ marginBottom:14 }}>
                <div style={{ display:"flex", justifyContent:"space-between", fontSize:12, marginBottom:4 }}>
                  <span>{cat}</span><span style={{ color:"var(--muted)" }}>{total} un.</span>
                </div>
                <div style={{ height:6, background:"var(--border)", borderRadius:3 }}>
                  <div style={{ height:"100%", width:`${pct}%`, background: total<5?"var(--danger)":"var(--accent)", borderRadius:3, transition:"width .5s" }} />
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  );
}

// ─── STATUS BADGE ─────────────────────────────────────────────────────────────
function StatusBadge({ s }) {
