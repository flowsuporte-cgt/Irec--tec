// ─── STORE (LOJA DO CLIENTE) ──────────────────────────────────────────────────
function StorePage({ goToAdmin }) {
  const [cat, setCat]       = useState("Todos");
  const [cart, setCart]     = useState([]);
  const [search, setSearch] = useState("");
  const [view, setView]     = useState("store"); // store | product | cart | checkout | success
  const [selProd, setSelProd] = useState(null);
  const [form, setForm]     = useState({ name:"", cpf:"", phone:"", zip:"", street:"", number:"", complement:"", city:"Irecê", state:"BA" });
  const [orderNum, setOrderNum] = useState(null);
  const [step, setStep]     = useState(1);
  const [toast, setToast]   = useState(null);
  const cats = ["Todos", ...new Set(MOCK_PRODUCTS.map(p=>p.category))];

  const filtered = MOCK_PRODUCTS.filter(p => p.is_active && (cat==="Todos"||p.category===cat) && (!search||p.title.toLowerCase().includes(search.toLowerCase())));
  const cartTotal = cart.reduce((a,i)=>a+(i.sale_price||i.price)*i.qty,0);
  const addToCart = (p) => {
    setCart(prev => { const ex = prev.find(i=>i.id===p.id); return ex ? prev.map(i=>i.id===p.id?{...i,qty:i.qty+1}:i) : [...prev,{...p,qty:1}]; });
    setToast(`${p.title.split(" ").slice(0,2).join(" ")} adicionado!`);
  };
  const finalize = () => {
    const num = "ORD-" + Date.now().toString().slice(-4); setOrderNum(num);
    setView("success"); setCart([]);
  };

  return (
    <div style={{ minHeight:"100vh" }}>
      <header className="store-header">
        <div className="store-logo">IRECÊ<span>TECH</span></div>
        <div style={{ display:"flex", gap:12, alignItems:"center" }}>
          <input className="input" style={{ width:220 }} placeholder="🔍 Buscar produto…" value={search} onChange={e=>setSearch(e.target.value)} />
          {view!=="cart"&&view!=="checkout"&&view!=="success" && (
            <div className="cart-btn" onClick={()=>setView("cart")}>
              🛒 Carrinho {cart.length>0 && <span className="cart-count">{cart.reduce((a,i)=>a+i.qty,0)}</span>}
            </div>
          )}
          <button className="btn btn-ghost" style={{ fontSize:12 }} onClick={goToAdmin}>⚙️ Painel</button>
        </div>
      </header>

      {/* STORE GRID */}
      {view==="store" && (
        <div style={{ padding:"28px 32px" }} className="fade-up">
          <div className="cat-filters">
            {cats.map(c=><div key={c} className={`cat-chip ${cat===c?"active":""}`} onClick={()=>setCat(c)}>{c}</div>)}
          </div>
          <div className="product-grid">
            {filtered.map(p=>(
              <div key={p.id} className="product-card" onClick={()=>{setSelProd(p);setView("product");}}>
                <img src={p.images_urls[0]} alt={p.title} />
                <div className="info">
                  <div className="cat">{p.category.toUpperCase()}</div>
                  <div className="name">{p.title}</div>
                  {p.stock_qty < 3 && <div style={{ fontSize:10, color:"var(--danger)", marginBottom:6 }}>⚠️ Últimas {p.stock_qty} unidades!</div>}
                  <div className="price-row">
                    <span className="price">{fmt(p.sale_price||p.price)}</span>
                    {p.sale_price && <span className="old-price">{fmt(p.price)}</span>}
                  </div>
                  {p.sale_price && <div style={{ fontSize:11, color:"#22c55e", marginTop:4 }}>💚 Economia de {fmt(p.price-p.sale_price)}</div>}
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* PRODUCT DETAIL */}
      {view==="product" && selProd && (
        <div style={{ padding:"28px 32px", maxWidth:800, margin:"0 auto" }} className="fade-up">
          <button className="btn btn-ghost" style={{ marginBottom:20 }} onClick={()=>setView("store")}>← Voltar</button>
          <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr", gap:32 }}>
            <img src={selProd.images_urls[0]} alt={selProd.title} style={{ width:"100%", borderRadius:12 }} />
            <div>
              <div style={{ fontSize:11, color:"var(--accent)", letterSpacing:1, marginBottom:8 }}>{selProd.category}</div>
              <h2 style={{ fontFamily:"var(--font-h)", fontSize:24, fontWeight:700, marginBottom:16 }}>{selProd.title}</h2>
              <p style={{ color:"var(--muted)", fontSize:14, lineHeight:1.6, marginBottom:20 }}>{selProd.description}</p>
              <div style={{ display:"flex", alignItems:"center", gap:12, marginBottom:8 }}>
                <span style={{ fontSize:32, fontWeight:800, color:"var(--accent)" }}>{fmt(selProd.sale_price||selProd.price)}</span>
                {selProd.sale_price && <span style={{ fontSize:16, color:"var(--muted)", textDecoration:"line-through" }}>{fmt(selProd.price)}</span>}
              </div>
              <div style={{ fontSize:12, color:"var(--muted)", marginBottom:20 }}>Estoque: {selProd.stock_qty} un. disponíveis</div>
              <div style={{ display:"flex", gap:10 }}>
                <button className="btn btn-primary" style={{ flex:1, justifyContent:"center" }} onClick={()=>{addToCart(selProd);setView("cart");}}>🛒 Comprar Agora</button>
                <button className="btn btn-ghost" onClick={()=>addToCart(selProd)}>+ Carrinho</button>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* CART */}
      {view==="cart" && (
        <div style={{ padding:"28px 32px", maxWidth:640, margin:"0 auto" }} className="fade-up">
          <button className="btn btn-ghost" style={{ marginBottom:20 }} onClick={()=>setView("store")}>← Continuar comprando</button>
          <h2 style={{ fontFamily:"var(--font-h)", fontSize:24, marginBottom:20 }}>Seu Carrinho</h2>
          {cart.length===0 ? (
            <div style={{ textAlign:"center", padding:40, color:"var(--muted)" }}>Carrinho vazio</div>
          ) : <>
            {cart.map(item=>(
              <div key={item.id} className="card" style={{ display:"flex", alignItems:"center", gap:16, marginBottom:12 }}>
                <img src={item.images_urls[0]} alt={item.title} style={{ width:60, height:60, borderRadius:8, objectFit:"cover" }} />
                <div style={{ flex:1 }}>
                  <div style={{ fontWeight:600, fontSize:14 }}>{item.title}</div>
                  <div style={{ color:"var(--accent)", fontWeight:700 }}>{fmt(item.sale_price||item.price)}</div>
                </div>
                <div style={{ display:"flex", alignItems:"center", gap:8 }}>
                  <button className="btn btn-ghost" style={{ padding:"4px 8px" }} onClick={()=>setCart(prev=>prev.map(i=>i.id===item.id&&i.qty>1?{...i,qty:i.qty-1}:i).filter(i=>i.qty>0))}>−</button>
                  <span style={{ fontWeight:600 }}>{item.qty}</span>
                  <button className="btn btn-ghost" style={{ padding:"4px 8px" }} onClick={()=>setCart(prev=>prev.map(i=>i.id===item.id?{...i,qty:i.qty+1}:i))}>+</button>
                  <button className="btn btn-danger" style={{ padding:"4px 10px", fontSize:12 }} onClick={()=>setCart(prev=>prev.filter(i=>i.id!==item.id))}>✕</button>
                </div>
              </div>
            ))}
            <div style={{ display:"flex", justifyContent:"space-between", fontWeight:700, fontSize:18, marginBottom:20, padding:"16px 0", borderTop:"1px solid var(--border)" }}>
              <span>Total</span><span style={{ color:"var(--accent)" }}>{fmt(cartTotal)}</span>
            </div>
            <button className="btn btn-primary" style={{ width:"100%", justifyContent:"center", fontSize:16, padding:"14px" }} onClick={()=>{setView("checkout");setStep(1);}}>Finalizar Compra →</button>
          </>}
        </div>
      )}

      {/* CHECKOUT */}
      {view==="checkout" && (
        <div style={{ padding:"28px 32px", maxWidth:580, margin:"0 auto" }} className="fade-up">
          <button className="btn btn-ghost" style={{ marginBottom:20 }} onClick={()=>setView("cart")}>← Voltar</button>
          <h2 style={{ fontFamily:"var(--font-h)", fontSize:24, marginBottom:4 }}>Finalizar Compra</h2>
          <p style={{ color:"var(--muted)", fontSize:13, marginBottom:20 }}>Preencha seus dados para entrega e emissão da nota fiscal</p>
          <div className="steps">
            {["Dados Pessoais","Endereço","Pagamento"].map((s,i)=>(
              <div key={s} className={`step ${step===i+1?"active":step>i+1?"done":""}`}>{step>i+1?"✓ ":""}{s}</div>
            ))}
          </div>

          {step===1 && <div>
            {[["Nome Completo","name","text","Maria da Silva"],["CPF ou CNPJ","cpf","text","000.000.000-00"],["WhatsApp","phone","tel","(74) 99999-0000"]].map(([l,k,t,ph])=>(
              <div key={k} className="form-group"><label>{l} <span style={{ color:"var(--danger)" }}>*</span></label>
                <input className="input" type={t} placeholder={ph} value={form[k]} onChange={e=>setForm(f=>({...f,[k]:e.target.value}))} />
              </div>
            ))}
            <button className="btn btn-primary" style={{ width:"100%", justifyContent:"center" }} disabled={!form.name||!form.cpf||!form.phone} onClick={()=>setStep(2)}>Próximo →</button>
          </div>}

          {step===2 && <div>
            {[["CEP","zip","text","44900-000"],["Rua / Avenida","street","text","Rua das Flores"],["Número","number","text","22"],["Complemento","complement","text","Apto 01 (opcional)"],["Cidade","city","text","Irecê"]].map(([l,k,t,ph])=>(
              <div key={k} className="form-group"><label>{l}</label>
                <input className="input" type={t} placeholder={ph} value={form[k]} onChange={e=>setForm(f=>({...f,[k]:e.target.value}))} />
              </div>
            ))}
            <div style={{ background:"rgba(0,212,255,.06)", borderRadius:8, padding:10, marginBottom:16, fontSize:12 }}>
              🚚 Frete para Irecê: <strong style={{ color:"var(--success)" }}>GRÁTIS</strong> | Região: R$ 25 | Outras cidades: R$ 45
            </div>
            <div style={{ display:"flex", gap:10 }}>
              <button className="btn btn-ghost" style={{ flex:1, justifyContent:"center" }} onClick={()=>setStep(1)}>← Voltar</button>
              <button className="btn btn-primary" style={{ flex:1, justifyContent:"center" }} onClick={()=>setStep(3)}>Próximo →</button>
            </div>
          </div>}

          {step===3 && <div>
            <div className="card" style={{ marginBottom:16 }}>
              <div style={{ fontWeight:600, marginBottom:12 }}>Resumo do Pedido</div>
              {cart.map(i=>(
                <div key={i.id} style={{ display:"flex", justifyContent:"space-between", fontSize:13, marginBottom:8 }}>
                  <span>{i.title.split(" ").slice(0,3).join(" ")} ×{i.qty}</span>
                  <span style={{ fontWeight:600 }}>{fmt((i.sale_price||i.price)*i.qty)}</span>
                </div>
              ))}
              <div style={{ borderTop:"1px solid var(--border)", marginTop:10, paddingTop:10, display:"flex", justifyContent:"space-between", fontWeight:700 }}>
                <span>Total</span><span style={{ color:"var(--accent)" }}>{fmt(cartTotal)}</span>
              </div>
            </div>
            <div className="form-group"><label>FORMA DE PAGAMENTO</label>
              <select className="input">
                <option>Pix (aprovação imediata)</option>
                <option>Cartão de Crédito</option>
                <option>Cartão de Débito</option>
              </select>
            </div>
            <div style={{ background:"rgba(34,197,94,.06)", border:"1px solid rgba(34,197,94,.2)", borderRadius:8, padding:12, fontSize:12, color:"var(--muted)", marginBottom:16 }}>
              🔒 Seus dados estão protegidos pela LGPD. Não compartilhamos informações pessoais.
            </div>
            <div style={{ display:"flex", gap:10 }}>
              <button className="btn btn-ghost" style={{ flex:1, justifyContent:"center" }} onClick={()=>setStep(2)}>← Voltar</button>
              <button className="btn btn-primary" style={{ flex:2, justifyContent:"center", fontSize:15, padding:"13px" }} onClick={finalize}>✅ Confirmar Pedido</button>
            </div>
          </div>}
        </div>
      )}

      {/* SUCCESS */}
      {view==="success" && (
        <div style={{ padding:"60px 32px", maxWidth:500, margin:"0 auto", textAlign:"center" }} className="fade-up">
          <div style={{ fontSize:72, marginBottom:16, animation:"pulse 2s infinite" }}>🎉</div>
          <h2 style={{ fontFamily:"var(--font-h)", fontSize:28, marginWeight:700, marginBottom:8 }}>Pedido Confirmado!</h2>
          <div style={{ fontSize:18, color:"var(--accent)", fontWeight:700, marginBottom:8 }}>{orderNum}</div>
          <p style={{ color:"var(--muted)", fontSize:14, lineHeight:1.6, marginBottom:24 }}>
            Você receberá uma confirmação no WhatsApp informado. Nossa equipe já recebeu seu pedido e iniciará a separação em breve.
          </p>
          <div className="card" style={{ textAlign:"left", marginBottom:24 }}>
            <div style={{ fontSize:11, color:"var(--muted)", marginBottom:4 }}>ENTREGAR EM</div>
            <div style={{ fontWeight:500 }}>{form.name}</div>
            <div style={{ fontSize:13, color:"var(--muted)" }}>{form.street}, {form.number} — {form.city}-BA</div>
          </div>
          <button className="btn btn-primary" style={{ width:"100%", justifyContent:"center" }} onClick={()=>{ setView("store"); setForm({ name:"", cpf:"", phone:"", zip:"", street:"", number:"", complement:"", city:"Irecê", state:"BA" }); }}>
            🛍️ Continuar Comprando
          </button>
        </div>
      )}

      {toast && <Toast msg={toast} onClose={()=>setToast(null)} />}
    </div>
  );
}

// ─── ROOT ─────────────────────────────────────────────────────────────────────
export default function App() {
  const [screen, setScreen] = useState("store"); // store | login | admin
  const [user, setUser]     = useState(null);

  const handleLogin = (u) => { setUser(u); setScreen("admin"); };
  const handleLogout = () => { setUser(null); setScreen("login"); };

  return (
    <>
      <style>{css}</style>
      {screen==="store" && <StorePage goToAdmin={()=>setScreen("login")} />}
      {screen==="login" && <LoginPage onLogin={handleLogin} goToStore={()=>setScreen("store")} />}
      {screen==="admin" && user && <AdminLayout user={user} onLogout={handleLogout} goToStore={()=>setScreen("store")} />}
    </>
  );
}
